{
	"name": "cantraceviewer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"wasm:build": "./scripts/build-wasm.sh dev",
		"wasm:build:release": "./scripts/build-wasm.sh release",
		"wasm:check": "cargo fmt --manifest-path wasm/Cargo.toml --check && cargo clippy --locked --manifest-path wasm/Cargo.toml --all-targets -- -D warnings",
		"wasm:test": "cargo test --locked --manifest-path wasm/Cargo.toml",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check && eslint .",
		"format": "oxfmt",
		"test:unit": "vitest run --configLoader runner --exclude src/lib/wasm.integration.test.ts",
		"test:integrationwasm": "vitest run --configLoader runner src/lib/wasm.integration.test.ts",
		"test": "vitest run --configLoader runner"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "5.2.8",
		"@fontsource-variable/geist-mono": "5.2.7",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^0.577.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"oxfmt": "0.50.0",
		"remixicon-svelte": "0.0.5",
		"shadcn-svelte": "1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-language-server": "0.18.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.58.1",
		"typescript-language-server": "5.3.0",
		"typescript-svelte-plugin": "0.3.52",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"wrangler": "^4.107.0"
	},
	"dependencies": {
		"chartgpu": "0.3.2",
		"idb": "8.0.3",
		"minisearch": "7.2.0",
		"modern-screenshot": "4.7.0",
		"runed": "0.37.1"
	}
}
