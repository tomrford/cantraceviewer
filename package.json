{
	"name": "cantraceviewer-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"package:build": "pnpm run wasm:build:release && pnpm --filter cantraceviewer run build",
		"package:pack": "pnpm run wasm:build:release && pnpm --filter cantraceviewer run pack:artifact",
		"package:pack:check": "pnpm --filter cantraceviewer run pack:check",
		"package:test:tarball": "node ./scripts/test-package-tarball.mjs",
		"package:test:app": "node ./scripts/test-app-tarball.mjs",
		"package:validate": "pnpm run wasm:check && pnpm run wasm:test && pnpm run package:pack && pnpm run package:test:tarball && pnpm run package:test:app",
		"validate": "pnpm run lint && pnpm run package:validate && pnpm run check:types && pnpm run test:run",
		"dev": "vite",
		"build": "vite build && node scripts/prerender.mjs",
		"wasm:build": "./scripts/build-wasm.sh dev",
		"wasm:build:release": "./scripts/build-wasm.sh release",
		"wasm:check": "cargo fmt --manifest-path wasm/Cargo.toml --check && cargo clippy --locked --manifest-path wasm/Cargo.toml --all-targets -- -D warnings",
		"wasm:test": "cargo test --locked --manifest-path wasm/Cargo.toml",
		"preview": "vite preview",
		"check": "pnpm run package:build && pnpm run check:types",
		"check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/core/tsconfig.json",
		"lint": "oxfmt --check && oxlint",
		"format": "oxfmt",
		"test": "pnpm run package:build && pnpm run test:run",
		"test:run": "vitest run --configLoader runner"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@fontsource-variable/geist": "5.2.8",
		"@fontsource-variable/geist-mono": "5.2.7",
		"@rolldown/plugin-babel": "0.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "1.0.0",
		"oxfmt": "0.71.0",
		"oxlint": "1.90.0",
		"shadcn": "4.23.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "1.4.0",
		"vite": "^8.3.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.156.0"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@tanstack/react-virtual": "3.14.23",
		"cantraceviewer": "0.3.0",
		"chartgpu": "0.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "1.1.1",
		"idb": "8.0.3",
		"lucide-react": "^1.63.0",
		"modern-screenshot": "4.7.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.5.0",
		"zustand": "^5.0.16"
	}
}
