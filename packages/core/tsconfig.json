{
	"compilerOptions": {
		"allowJs": false,
		// The Node worker entry is loaded from disk by Node's type stripping, which needs `.ts`
		// import specifiers; the packaged build rewrites them to `.js` on emit.
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["node"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts"]
}
