{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortTailwindcss": {
		"stylesheet": "./src/app.css"
	},
	"sortPackageJson": false,
	"ignorePatterns": [
		"package-lock.json",
		"pnpm-lock.yaml",
		"yarn.lock",
		"/static/",
		"/wasm/",
		"/packages/core/src/wasm-bindgen/"
	]
}
