{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortTailwindcss": {
		"stylesheet": "./src/app.css"
	},
	"sortPackageJson": false,
	"ignorePatterns": ["pnpm-lock.yaml", "/static/", "/wasm/", "/packages/core/src/wasm-bindgen/"]
}
